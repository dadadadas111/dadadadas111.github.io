    {
      "parameters": {
        "jsCode": "const text = ($json.text || \"\").trim().toLowerCase();\nconst month = $json.value\n  ? JSON.parse($json.value)\n  : {\n      month: $json.month,\n      income: 9000000,\n      totals: { needs: 0, wants: 0, savings: 0 },\n    };\nconst classify = (label) => {\n  if (/grab|xe|xăng|bus|đi lại/.test(label)) return [\"transport\", \"needs\"];\n  if (/cafe|trà sữa|snack/.test(label)) return [\"cafe\", \"wants\"];\n  if (/tiết kiệm|savings|đầu tư|etf/.test(label)) return [\"savings\", \"savings\"];\n  if (/điện|nước|trọ|rent/.test(label)) return [\"utilities\", \"needs\"];\n  if (/ăn|cơm|phở|bún|food/.test(label)) return [\"food_basic\", \"needs\"];\n  return [\"other\", \"wants\"];\n};\nconst toAmount = (s) => {\n  const m = s.match(/(\\d+(?:[.,]\\d+)?)(k|000)?/i);\n  if (!m) return 0;\n  let n = parseFloat(m[1].replace(\",\", \".\"));\n  if ((m[2] || \"\").toLowerCase() === \"k\") n *= 1000;\n  return Math.round(n);\n};\nlet today = { date: $json.date, items: [], total: 0, raw_text: text };\nlet message = \"\";\nif (/^\\/month/i.test(text) || /^\\/budget/i.test(text)) {\n  const income = Math.max(1, month.income || 9000000);\n  const n = Math.round(((month.totals.needs || 0) / income) * 100);\n  const w = Math.round(((month.totals.wants || 0) / income) * 100);\n  const s = Math.round(((month.totals.savings || 0) / income) * 100);\n  message = `Tháng ${month.month}:\\n- Needs: ${n}%\\n- Wants: ${w}%\\n- Savings: ${s}%`;\n  today = {};\n} else if (text === \"0\") {\n  message = \"Đã ghi hôm nay không chi tiêu.\";\n} else {\n  const parts = text\n    .split(/,|;/)\n    .map((v) => v.trim())\n    .filter(Boolean);\n  for (const p of parts) {\n    const amount = toAmount(p);\n    if (!amount) continue;\n    const label =\n      p.replace(/(\\d+(?:[.,]\\d+)?)(k|000)?/gi, \"\").trim() || \"other\";\n    const pair = classify(label);\n    today.items.push({ label, amount, category: pair[0], bucket: pair[1] });\n    today.total += amount;\n    month.totals[pair[1]] = (month.totals[pair[1]] || 0) + amount;\n  }\n  message = today.items.length\n    ? \"Đã ghi nhận:\\n\" +\n      today.items.map((i) => `- ${i.label} ${i.amount}`).join(\"\\n\") +\n      `\\nTổng hôm nay: ${today.total}`\n    : \"Tôi chưa parse được khoản chi. Ví dụ: ăn 60k, cafe 35k, grab 25k\";\n}\nreturn [\n  {\n    json: {\n      ...$json,\n      month,\n      todayTxn: today,\n      message_text: message,\n      skipTxn: !today.date,\n    },\n  },\n];\n"
      },
